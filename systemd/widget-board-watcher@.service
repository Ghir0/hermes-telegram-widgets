[Unit]
Description=Telegram widget board watcher (refresh on Kanban changes)
After=network.target

[Service]
Type=simple
User=%i
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/%i/.hermes/plugins/telegram-widgets
ExecStart=/usr/bin/python3 -u watcher.py --interval 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
